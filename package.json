{
  "name": "base-do-suporte-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "password:hash": "node scripts/hash-password.js",
    "test": "node --test"
  },
  "dependencies": {
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "zod": "4.6.7"
  }
}
