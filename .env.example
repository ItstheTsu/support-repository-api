PORT=1992
HOST=0.0.0.0
DATABASE_PATH=./data/knowledge.sqlite
FRONTEND_DIST=../support-repository/dist
# Replace localhost with the server's internal IP for LAN use.
PUBLIC_ORIGIN=http://localhost:1992
SUPPORT_USERNAME=suporte
# Generate with npm run password:hash. Never put this in VITE_*.
SUPPORT_PASSWORD_HASH=
# The existing internal network workflow uses HTTP on port 1992.
COOKIE_SECURE=false
NODE_ENV=production
